[CmdletBinding()]
param()

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Write-Section {
    param([string]$Title)

    Write-Host ""
    Write-Host "== $Title ==" -ForegroundColor Cyan
}

function Format-Bytes {
    param([double]$Bytes)

    if ($Bytes -ge 1TB) {
        return "{0:N1} TB" -f ($Bytes / 1TB)
    }
    if ($Bytes -ge 1GB) {
        return "{0:N1} GB" -f ($Bytes / 1GB)
    }
    if ($Bytes -ge 1MB) {
        return "{0:N1} MB" -f ($Bytes / 1MB)
    }
    return "{0:N1} KB" -f ($Bytes / 1KB)
}

Write-Section "Windows System Health"

$operatingSystem = Get-CimInstance -ClassName Win32_OperatingSystem
$computerSystem = Get-CimInstance -ClassName Win32_ComputerSystem
$processor = Get-CimInstance -ClassName Win32_Processor |
    Measure-Object -Property LoadPercentage -Average
$uptime = (Get-Date) - $operatingSystem.LastBootUpTime

Write-Host ("{0,-16} {1}" -f "Computer:", $env:COMPUTERNAME)
Write-Host ("{0,-16} {1}" -f "OS:", $operatingSystem.Caption)
Write-Host ("{0,-16} {1}" -f "Uptime:", "$([int]$uptime.Days)d $($uptime.Hours)h $($uptime.Minutes)m")

Write-Section "CPU"
$cpuLoad = [int][Math]::Round($processor.Average)
Write-Host ("{0,-16} {1}%" -f "Load:", $cpuLoad)
Write-Host ("{0,-16} {1}" -f "Logical CPUs:", $computerSystem.NumberOfLogicalProcessors)

Write-Section "Memory"
$memoryUsed = $operatingSystem.TotalVisibleMemorySize * 1KB - $operatingSystem.FreePhysicalMemory * 1KB
Write-Host ("{0,-16} {1}" -f "Total:", (Format-Bytes ($operatingSystem.TotalVisibleMemorySize * 1KB)))
Write-Host ("{0,-16} {1}" -f "Used:", (Format-Bytes $memoryUsed))
Write-Host ("{0,-16} {1}" -f "Available:", (Format-Bytes ($operatingSystem.FreePhysicalMemory * 1KB)))

Write-Section "Disk"
Get-CimInstance -ClassName Win32_LogicalDisk -Filter "DriveType = 3" |
    Sort-Object -Property DeviceID |
    ForEach-Object {
        $used = $_.Size - $_.FreeSpace
        $percentUsed = if ($_.Size -gt 0) {
            [int][Math]::Round(($used / $_.Size) * 100)
        } else {
            0
        }

        $label = "{0,-16}" -f "$($_.DeviceID):"
        $details = "{0} used of {1} ({2}% used)" -f `
            (Format-Bytes $used),
            (Format-Bytes $_.Size),
            $percentUsed

        if ($percentUsed -ge 90) {
            Write-Host $label -NoNewline
            Write-Host $details -ForegroundColor Yellow
        } else {
            Write-Host "$label $details"
        }
    }
